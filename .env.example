# ============================================================
# COPY this file to ".env" and fill in your own values.
#   cp .env.example .env
# NEVER commit .env to Git. NEVER put these secrets in frontend code.
# ============================================================

# Server
PORT=3000
NODE_ENV=development

# Business info (also shown on the site / used for WhatsApp)
BUSINESS_NAME=Your Business Name
SUPPORT_EMAIL=support@example.com
# WhatsApp number in international format WITHOUT + or spaces
# Example for India: 919876543210  (91 = country code + 10-digit number)
# >>> THIS IS THE ONE PLACE TO CHANGE THE WHATSAPP NUMBER <<<
WHATSAPP_NUMBER=919999999999

# --- Razorpay (payment gateway for UPI / cards / netbanking in India) ---
# Get these from https://dashboard.razorpay.com/app/keys
# Use TEST keys (rzp_test_...) while testing, LIVE keys only at launch.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Webhook secret: Razorpay Dashboard > Settings > Webhooks > Add webhook
# URL will be: https://your-domain.com/api/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# --- Admin dashboard (email + password login at /admin/login) ---
# 1. Run:  npm run admin:password      (type your email and a strong password; it is never shown or saved)
# 2. Paste the two lines it prints here and into Render > Environment.
#    ADMIN_PASSWORD_HASH is a one-way hash, not your password. Changing it changes the password.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD_HASH=run-npm-run-admin-password-and-paste-the-result-here
# Set to "production" on Render (enables Secure cookies, HTTPS-only headers, proxy support)
# NODE_ENV=production
# Optional: store the SQLite file on a persistent disk (Render > Disks), e.g. /var/data/store.db
# DB_PATH=/var/data/store.db
# (ADMIN_TOKEN is no longer used — the old token-in-URL admin page was removed.)

# If Razorpay keys are empty, the app runs in MOCK MODE (no real money).
# Mock mode is ONLY for local UI testing. See README > Test Mode.
